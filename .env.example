NUXT_PUBLIC_APP_NAME=FretePro

# Cotação de frete (só no server; ver README e docs/DECISIONS.md).
# Vazio: dados simulados em "pnpm dev" e Melhor Envio no build de produção.
# Para a API real em desenvolvimento, use "melhor-envio" e preencha token e user agent.
# "mock" só funciona em desenvolvimento.
NUXT_FREIGHT_API_MODE=
NUXT_MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
NUXT_MELHOR_ENVIO_TOKEN=
NUXT_MELHOR_ENVIO_USER_AGENT=FretePro (seu-email@exemplo.com)
